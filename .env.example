# ---- Runtime -------------------------------------------------------------
KUMBH_ENV=dev                     # dev | staging | prod
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://localhost:5173

# ---- Data stores ---------------------------------------------------------
# Production: PostgreSQL 15 + PostGIS 3
DATABASE_URL=postgresql+psycopg2://kumbh:kumbh@localhost:5432/kumbh
# Dev without Docker (no PostGIS, distance sorting falls back to haversine in SQL):
# DATABASE_URL=sqlite:///./kumbh_dev.db

REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP=localhost:9092

# ---- Security ------------------------------------------------------------
JWT_SECRET=change-me-in-vault        # load from secret manager in prod, never commit
JWT_TTL_SECONDS=86400
OFFICER_MFA_REQUIRED=1

# ---- OTP ----------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_LENGTH=6
# 1 = return the OTP in the API response (dev only). Must be 0 in staging/prod.
OTP_DEBUG_RETURN=1

# ---- Integrations (stubs until agency API access is confirmed) ----------
SMS_GATEWAY_URL=
SMS_GATEWAY_KEY=
PUSH_FCM_SERVER_KEY=
WEATHER_API_URL=
ROUTING_ENGINE_URL=                  # OSRM / Valhalla instance for real routing
MAP_TILE_URL=https://tiles.example.internal/{z}/{x}/{y}.png
DIAL112_WEBHOOK_SECRET=
